        cmd_col = paint(f"{cmd:<{width}}", C.BOLD, C.CYAN)
        print(f"  {cmd_col}  {dim(desc)}")
    heading("EXAMPLES")
    examples = (
        "sspinner register myapp",
        "sspinner run myapp",
        "sspinner run myapp -b   # background: no window",
        "sspinner exec myapp back bash",
        "sspinner stop myapp",
        "sspinner list",
    )
    for line in examples:
        print(dim(f"  {line}"))
    print(f"\n{dim('logs:')} {DOZZLE_URL}")


def build_parser():
    parser = argparse.ArgumentParser(prog="sspinner", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("register", help="interactively define a project's services")
    p.add_argument("name", help="project name")
    p.set_defaults(func=cmd_register)

    p = sub.add_parser("edit", help="open a project's config in $EDITOR")
    p.add_argument("name", help="project name")
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("list", help="show registered projects and live status")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("run", help="boot a registered project's stack")
    p.add_argument("name", help="project name")
    p.add_argument(
        "-b", "--background", action="store_true",
        help="boot detached: no window, output logged to temp files",
    )
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("stop", help="tear down a registered project's stack")
    p.add_argument("name", help="project name")
    p.set_defaults(func=cmd_stop)

    # deprecated alias for 'stop' - hidden from help, still functional
    p = sub.add_parser("down", help=argparse.SUPPRESS)
    p.add_argument("name", help="project name")
    p.set_defaults(func=cmd_down)

    infra = sub.add_parser("infra", help="manage the shared Dozzle log viewer")
    infra_sub = infra.add_subparsers(dest="infra_command", required=True)
    p = infra_sub.add_parser("up", help="start Dozzle")
    p.set_defaults(func=cmd_infra_up)
    p = infra_sub.add_parser("down", help="stop Dozzle")
    p.set_defaults(func=cmd_infra_down)

    p = sub.add_parser("_names", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_names)

    # Hidden completion helpers for 'exec' - see completions/sspinner.bash
    # and completions/_sspinner, which depend on their exact output format
    # (one name per line, nothing else) the same way they already depend on
    # '_names'. 'exec' itself is NOT wired up here - see main()'s comment on
    # why it's parsed by hand instead of through argparse.
    p = sub.add_parser("_docker_services", help=argparse.SUPPRESS)
    p.add_argument("name")
    p.set_defaults(func=cmd_docker_services)

    p = sub.add_parser("_containers", help=argparse.SUPPRESS)
    p.add_argument("name")
    p.add_argument("service")
    p.set_defaults(func=cmd_containers)

    return parser


def _run_exec(argv):
    # 'exec' is parsed by hand rather than through build_parser(): the
    # trailing command must pass through completely untouched, including its
    # own dashes (`bash -c "..."`, `psql -U postgres`), and argparse.REMAINDER
    # can't do that alongside a same-subparser -c/--container flag - REMAINDER
    # swallows everything from the point it activates, options included,
    # rather than letting an earlier -c route to that flag. See CLAUDE.md's
    # 'exec' section for the full rationale.
    #
    # -c/--container is only recognised in the fixed slot right after
    # <service> - never by scanning the whole argv, since the command being
    # exec'd routinely has its own -c (`bash -c ...`, `sh -c ...`) that must
    # not be mistaken for sspinner's own flag.
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: sspinner exec <project> <service> [-c/--container NAME] <command>...")
        return
    args = list(argv)
    if len(args) < 2:
        err("usage: sspinner exec <project> <service> [-c CONTAINER] <command>...")
        sys.exit(2)
    project, service_name = args[0], args[1]
    rest = args[2:]
    container = None
    if rest and rest[0] in ("-c", "--container"):
        if len(rest) < 2:
            err(f"{rest[0]} needs a value")
            sys.exit(2)
        container = rest[1]
        rest = rest[2:]
    cmd_exec(project, service_name, container, rest)


def main():
    if len(sys.argv) == 1 or sys.argv[1] in ("-h", "--help"):
        print_help()
        return
    if sys.argv[1] == "exec":
        _run_exec(sys.argv[2:])
        return
    args = build_parser().parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
