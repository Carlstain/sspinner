def cmd_exec(project, service_name, container_arg, command):
    # A shortcut for `docker compose exec` into one of a project's docker
    # services - saves cd-ing to the repo and remembering the pinned -p
    # project name. Docker-only by definition; see main()'s manual argv
    # handling for why this isn't a normal argparse subcommand (the trailing
    # command needs to pass through untouched, including its own dashes,
    # which argparse.REMAINDER can't do alongside a same-subparser -c flag).
    registry = load_registry()
    entry = _require_project(registry, project)
    svc = _find_service(entry, service_name)
    if svc is None:
        err(f"'{service_name}' isn't a service of '{project}'.")
        sys.exit(1)
    if svc["runner"] != "docker-compose":
        err(f"'{service_name}' isn't a docker-compose service - 'exec' only works on those.")
        sys.exit(1)

    containers = _compose_containers(svc)
    container = container_arg or (service_name if service_name in containers else None)
    if container is None or (containers and container not in containers):
        if containers:
            err(f"'{container_arg or service_name}' isn't a container of '{service_name}'. "
                f"Available: {', '.join(containers)}")
        else:
            err(f"couldn't determine '{service_name}''s containers - is its compose file valid?")
        sys.exit(1)

    project_name = svc["compose_project"]
    running = subprocess.run(
        ["docker", "compose", "-p", project_name, "ps", "--status", "running", "-q", container],
        capture_output=True, text=True,
    )
    if not running.stdout.strip():
        if not sys.stdin.isatty():
            err(f"'{service_name}' isn't running. Start it with: sspinner run {project}")
            sys.exit(1)
        choice = ask_choice(
            f"'{service_name}' isn't running - what do you want to do?",
            [f"Run '{project}' now, then exec", "Cancel"],
        )
        if choice.startswith("Cancel"):
            sys.exit(0)
        cmd_run(argparse.Namespace(name=project, background=False))

    if not command:
        err("no command given, e.g.: sspinner exec <project> <service> bash")
        sys.exit(1)

    os.execvp("docker", ["docker", "compose", "-p", project_name, "exec", container, *command])


# --------------------------------------------------------------------- run
def running_projects(registry, exclude=None):
    running = []
    for name, entry in registry.items():
        if name == exclude:
            continue
        if any(service_running(svc, project=name) for svc in entry["services"]):
            running.append(name)
    return running


DOWN_TIMEOUT_S = "10"


def teardown_project(name, entry):
    # Returns True if the project came down cleanly (every docker-compose
    # project actually has no containers left, every non-docker service's
    # process is actually gone, and every declared port is actually free),
    # False if anything is still hanging. cmd_stop turns that into the
    # process exit code; check_other_running (which also calls this, for its
    # "stop the other project and continue" choice) treats a partial failure
    # as a warning rather than aborting the run it was trying to get to.
    heading(f"Stopping '{name}'")
    services = entry["services"]

    if not sys.stdout.isatty():
        # Non-tty keeps the pre-dynamic behavior's shape: static table once,
        # subprocess output streaming straight through, plain ok()/err()
        # lines. Mirrors cmd_run's animate split. Every service (not just
        # docker-compose ones) is now verified rather than assumed stopped -
        # see the tty branch below for why.
        rows = []
        for svc in services:
            detail = svc.get("compose_project") or svc.get("script") or svc.get("command", "") or "-"
            rows.append([svc["name"], svc["runner"], detail])
        print(render_table(["service", "runner", "detail"], rows))

        clean = True
        for svc in reversed(services):
            svc_name = svc["name"]
            if svc["runner"] == "docker-compose":
                project = svc["compose_project"]
                print(f"  stopping {paint(svc_name, C.BOLD)}...")
                down_cmd = ["docker", "compose", "-p", project, "down",
                            "--remove-orphans", "-t", DOWN_TIMEOUT_S]
                subprocess.run(down_cmd)
                if compose_has_containers(project):
                    warn(f"{svc_name}: containers still up, retrying 'down'...")
                    subprocess.run(down_cmd)
                if compose_has_containers(project):
                    err(f"{svc_name}: containers still up after retry")
                    clean = False
                else:
                    # Best-effort: close the leftover pane shell (the
                    # `logs -f; exec bash` tail) now that the container it
                    # was following is gone. Never affects the clean verdict.
                    kill_tracked_process(name, svc_name, svc["path"])
            else:
                if kill_tracked_process(name, svc_name, svc["path"]):
                    ok(f"stopped {svc_name}")
            if svc.get("port") and (svc["runner"] != "docker-compose" or clean):
                if wait_for_port_free(svc["port"]):
                    ok(f"port {svc['port']} for {svc_name} is free")
                else:
                    holder = _identify_port_holder(svc["port"])
                    hint = f" (held by {holder})" if holder else " (couldn't identify what's holding it)"
                    err(f"port {svc['port']} for {svc_name} is still in use{hint}")
                    clean = False
        clear_run_state(name)
        return clean

    # tty: same treatment as the run view - ONE table (StopTable), rendered
    # once with real service_running() statuses, updated in place. Subprocess
    # output is captured (Popen+PIPE) rather than streamed: anything writing
    # to stdout mid-frame would land inside the _Frame region and corrupt the
    # next redraw, so it's swallowed on success and printed only *after* the
    # frame is finalized on failure. All services - not just docker-compose
    # ones - are torn down and then verified in REVERSE boot order (dependents
    # come down before their dependencies); the table's display rows stay in
    # boot order.
    table = StopTable(services, name)
    table.draw()
    compose_failures = []  # (svc_name, captured compose output)
    port_failures = []  # (svc_name, port, holder_or_None)
    clean = True

    reversed_services = list(reversed(services))
    total = len(reversed_services)
    for i, svc in enumerate(reversed_services):
        svc_name = svc["name"]

        def status_tick(spinner, elapsed, label="stopping"):
            table.set_status(svc_name, (f"{spinner} {label} ({int(elapsed)}s)", C.YELLOW), animate=False)
            table.set_context(dim(f"{spinner} {label} {svc_name} ({i + 1}/{total})"), animate=True)

        service_ok = True
        if svc["runner"] == "docker-compose":
            project = svc["compose_project"]

            def run_down_attempt():
                proc = subprocess.Popen(
                    ["docker", "compose", "-p", project, "down",
                     "--remove-orphans", "-t", DOWN_TIMEOUT_S],
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                )
                attempt_start = time.time()
                frame_i = 0
                while proc.poll() is None:
                    status_tick(_SPINNER_FRAMES[frame_i % len(_SPINNER_FRAMES)],
                                time.time() - attempt_start)
                    frame_i += 1
                    time.sleep(0.25)
                return proc.stdout.read() if proc.stdout else ""

            output = run_down_attempt()
            if compose_has_containers(project):
                output += run_down_attempt()
            if compose_has_containers(project):
                table.set_status(svc_name, ("✗ still up", C.RED), animate=True)
                compose_failures.append((svc_name, output))
                clean = False
                service_ok = False
            else:
                table.set_status(svc_name, ("○ stopped", C.DIM), animate=True)
                # Best-effort: close the leftover pane shell now that the
                # container it was following is gone. Doesn't affect status.
                kill_tracked_process(name, svc_name, svc["path"])
        else:
            kill_tracked_process(name, svc_name, svc["path"], tick=status_tick)
            table.set_status(svc_name, ("○ stopped", C.DIM), animate=True)

        if svc.get("port") and service_ok:
            def port_tick(spinner, elapsed):
                status_tick(spinner, elapsed, label="waiting for port")
            if wait_for_port_free(svc["port"], tick=port_tick):
                table.set_status(svc_name, ("○ stopped", C.DIM), animate=True)
            else:
                holder = _identify_port_holder(svc["port"])
                table.set_status(svc_name, (f"✗ port {svc['port']} in use", C.RED), animate=True)
                port_failures.append((svc_name, svc["port"], holder))
                clean = False

    final_context = dim(f"'{name}' stopped") if clean else None
    table.set_context(final_context, animate=True)

    # Only now, with the frame finalized (nothing redraws above this point),
    # is it safe to print captured output for any failures.
    for svc_name, output in compose_failures:
        err(f"docker compose down failed for {svc_name}:")
        if output:
            sys.stdout.write(output if output.endswith("\n") else output + "\n")
    for svc_name, port, holder in port_failures:
        hint = f" (held by {holder})" if holder else " (couldn't identify what's holding it)"
        err(f"port {port} for {svc_name} is still in use{hint}")

    clear_run_state(name)
    return clean


def check_other_running(registry, name):
    others = running_projects(registry, exclude=name)
    if not others:
        return

    heading("Another project looks like it's already running")
    rows = []
    for o in others:
        live = [s["name"] for s in registry[o]["services"] if service_running(s, project=o)]
        status = (", ".join(live), C.GREEN) if live else ("(docker only)", C.DIM)
        rows.append([o, status])
    print(render_table(["project", "running services"], rows))

    if not sys.stdin.isatty():
        warn("non-interactive - leaving it running and continuing")
        return

    label = others[0] if len(others) == 1 else "them"
    choice = ask_choice(
        "what do you want to do?",
        [f"Stop {label} and continue", "Keep it running and start this too", "Cancel"],
    )
    if choice == "Cancel":
        print("cancelled")
        sys.exit(0)
    if choice.startswith("Stop"):
        for o in others:
            # A partial teardown failure here (a leftover container/port on
            # the OTHER project) is worth a warning, but shouldn't abort the
            # run this prompt exists to get to - only 'sspinner stop' itself
            # turns "not clean" into a non-zero exit.
            if not teardown_project(o, registry[o]):
                warn(f"'{o}' didn't stop cleanly - continuing anyway")


def run_terminal_windows(name, entry, table, animate):
    # The Terminator-less windowed backend: one titled window per service via
    # resolve_terminal(), opened in boot order with the same port-poll-before-
    # next-service sequencing run_terminator() uses (there's no multiplexer
    # session here either, just N independent processes) - reports through
    # `table` the same way. No tmux-style "session" to query, so "already
    # running" is the same service_running() snapshot run_terminator() uses.
    services = entry["services"]
    if services and all(service_running(s, project=name) for s in services):
        for svc in services:
            table.set_status(svc["name"], ("◒ already up", C.GREEN), animate=False)
        if not animate:
            ok(f"'{name}' looks like it's already running")
        return

    binary_name, binary_path = resolve_terminal()

    total = len(services)
    try:
        for i, svc in enumerate(services):
            # Launches strictly sequentially (this Popen only runs once the
            # previous service's wait, below, returns) - so unlike
            # run_terminator(), a preflight check here actually runs before
            # this service's own command has a chance to bind the port.
            if not _preflight_port(name, svc, table, animate):
                continue
            cmd = build_pane_command(svc, pidfile=_pidfile_path(name, svc["name"]))
            title = f"sspinner: {name} — {svc['name']}"
            subprocess.Popen(_terminal_argv(binary_name, binary_path, title, cmd))
            _poll_service_boot(name, svc, table, animate, i, total)
    except _BootAborted:
        table.set_context(dim(f"'{name}' boot aborted"), animate=animate)
        return True


def _configobj_value(value):
    # ConfigObj (terminator's config format) needs triple-quoting for values
    # with spaces/quotes/#, or that are empty - everything else can be bare.
    value = str(value)
    if value == "" or re.search(r'''[\s"'#]''', value):
        return f"'''{value}'''"
    return value


def _terminator_layout(project, services):
    # Grid layout: at most 2 terminals per row, rows stacked top-to-bottom,
    # boot order mapping left-to-right then top-to-bottom. Schema
    # reverse-engineered from the installed terminatorlib source (config.py
    # DEFAULTS['layouts'], terminal.py describe_layout/create_layout,
    # paned.py create_layout) since it isn't documented: a Paned widget
    # (HPaned/VPaned) always has exactly 2 children, distinguished by their
    # own 'order' field (0 = left/top, 1 = right/bottom) relative to that
    # shared parent - so a full row of 2 is one HPaned, and rows are chained
    # together vertically through nested VPaneds (the same "chain through
    # a single parent" trick the old side-by-side-only version used, just
    # one level up: chaining rows instead of chaining terminals directly).
    # Shapes this produces: N=1 -> single Terminal. N=2 -> one HPaned(t0,t1).
    # N=3 -> VPaned(HPaned(t0,t1), t2). N=4 -> VPaned(HPaned(t0,t1),
    # HPaned(t2,t3)). N=5 -> VPaned(HPaned(t0,t1), VPaned(HPaned(t2,t3), t4)).
    def pane_command(svc):
        return build_pane_command(svc, pidfile=_pidfile_path(project, svc["name"]))

    layout = {"window0": {"type": "Window", "parent": ""}}
    n = len(services)
    if n == 1:
        layout["terminal0"] = {
            "type": "Terminal", "parent": "window0", "order": 0,
            "profile": "default", "command": pane_command(services[0]),
        }
        return layout

    def add_terminal(index, parent, order):
        layout[f"terminal{index}"] = {
            "type": "Terminal", "parent": parent, "order": order,
            "profile": "default", "command": pane_command(services[index]),
        }

    def build_row(indices, parent, order, row_num):
        # A row of 1 (only possible for the trailing row on odd N) attaches
        # its lone terminal directly; a row of 2 becomes its own HPaned.
        if len(indices) == 1:
            add_terminal(indices[0], parent, order)
            return
        hpaned_id = f"hpaned{row_num}"
        layout[hpaned_id] = {"type": "HPaned", "parent": parent, "order": order}
        add_terminal(indices[0], hpaned_id, 0)
        add_terminal(indices[1], hpaned_id, 1)

    rows = [list(range(i, min(i + 2, n))) for i in range(0, n, 2)]
    if len(rows) == 1:
        build_row(rows[0], "window0", 0, 0)
        return layout

    parent = "window0"
    for row_num, row in enumerate(rows[:-1]):
        vpaned_id = f"vpaned{row_num}"
        layout[vpaned_id] = {"type": "VPaned", "parent": parent, "order": 1}
        build_row(row, vpaned_id, 0, row_num)
        parent = vpaned_id
    build_row(rows[-1], parent, 1, len(rows) - 1)
    return layout


def run_terminator(name, entry, table, animate):
    # Same table-reporting contract as run_terminal_windows above. Terminator has no
    # per-pane launch step to straddle (the whole layout opens in one Popen
    # call), so the per-service loop below is purely the port-polling
    # sequence - but it still walks services in boot order and marks each
    # "starting" before polling, so the table reads the same progression.
    services = entry["services"]
    if services and all(service_running(s, project=name) for s in services):
        for svc in services:
            table.set_status(svc["name"], ("◒ already up", C.GREEN), animate=False)
        if not animate:
            ok(f"'{name}' looks like it's already running")
        return

    layout_name = f"sspinner-{name}"
    layout = _terminator_layout(name, services)
    lines = ["[profiles]", "[[default]]", "[layouts]", f"[[{layout_name}]]"]
    for obj_id, fields in layout.items():
        lines.append(f"[[[{obj_id}]]]")
        for key, value in fields.items():
            lines.append(f"{key} = {_configobj_value(value)}")

    with tempfile.NamedTemporaryFile("w", suffix=".config", delete=False) as tf:
        tf.write("\n".join(lines) + "\n")
        config_path = tf.name

    subprocess.Popen([
        "terminator", "-u", "-g", config_path, "-l", layout_name,
        "-T", f"sspinner: {name}",
    ])

    # Every pane's command already started the instant the window opened
    # above (the whole grid launches in one Popen call, unlike
    # run_terminal_windows()'s sequential per-window Popen) - so there's no
    # per-service preflight to offer here, only the shared reporting step.
    total = len(services)
    try:
        for i, svc in enumerate(services):
            _poll_service_boot(name, svc, table, animate, i, total)
    except _BootAborted:
        table.set_context(dim(f"'{name}' boot aborted"), animate=animate)
        return True


def run_fallback(name, entry, background=False):
    # background=True (run -b, which always uses this backend now - see
    # cmd_run) skips the exec-last-service-into-the-foreground special case
    # below - every service gets the same Popen+logfile treatment and
    # control returns to the shell. Every Popen'd process is still tracked
    # via a pidfile (start_new_session=True gives it its own process group),
    # so `stop` can kill it later even though there's no window/session to
    # tear down for it directly.
    if background:
        warn("running in the background - services start sequentially, no split panes.")
    else:
        warn("no terminator or terminal emulator found - running services sequentially, no split panes.")
    services = entry["services"]
    for i, svc in enumerate(services):
        is_last = i == len(services) - 1
        pidfile = _pidfile_path(name, svc["name"])
        cmd = build_pane_command(svc, pidfile=pidfile)
        heading(f"Starting {svc['name']}")
        if not background and is_last and svc["runner"] != "docker-compose":
            print(dim(f"    {cmd}"))
            # cmd already starts with `echo $$ > "<pidfile>";` (from
            # build_pane_command) and execvp preserves this process's pid, so
            # the pidfile is written correctly with no separate step needed.
            os.execvp("bash", ["bash", "-c", cmd])
            return  # unreachable
        log_path = Path(tempfile.gettempdir()) / f"sspinner-{name}-{svc['name']}.log"
        logf = open(log_path, "w")
        subprocess.Popen(
            ["bash", "-c", cmd], stdout=logf, stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        print(dim(f"    logging to {log_path}"))
        if svc.get("port"):
            rcfile = _rcfile_path(name, svc["name"])
            boot_start = time.time()
            outcome = wait_for_port(svc["port"], label=svc["name"], rcfile=rcfile)
            elapsed = time.time() - boot_start
            if outcome == "up":
                ok(f"{svc['name']} is up on :{svc['port']} ({elapsed:.1f}s)")
            elif outcome == "exited":
                err(f"{svc['name']} exited ({_read_rc(rcfile)}) before it came up on :{svc['port']} - see {log_path}")
            else:
                err(f"timed out waiting for {svc['name']} on :{svc['port']}")
    print(f"\nAll services started in background. Logs: {DOZZLE_URL}")


def _scope_services(entry, only=None, except_names=None):
    # Returns a shallow copy of entry with its services filtered to the
    # given names (boot order preserved) - used by 'run --only/--except'
    # and 'restart <name> [service...]' so a scoped operation reuses
    # teardown_project()/the run backends unchanged, rather than a second,
    # weaker path re-implementing their verify-and-escalate or boot-order
    # logic for a subset.
    services = entry["services"]
    known = {s["name"] for s in services}
    for names in (only, except_names):
        unknown = [n for n in names or [] if n not in known]
        if unknown:
            err(f"unknown service(s): {', '.join(unknown)}")
            sys.exit(1)
    if only is not None:
        services = [s for s in services if s["name"] in only]
    if except_names:
        services = [s for s in services if s["name"] not in except_names]
    return {**entry, "services": services}


def cmd_run(args):
    registry = load_registry()
    entry = _require_project(registry, args.name)

    check_other_running(registry, args.name)

    infra_up()
    if entry.get("network"):
        ensure_network(entry["network"])

    only = [n.strip() for n in args.only.split(",")] if getattr(args, "only", None) else None
    except_names = (
        [n.strip() for n in args.except_.split(",")] if getattr(args, "except_", None) else None
    )
    scoped = bool(only or except_names)
    if scoped:
        entry = _scope_services(entry, only=only, except_names=except_names)
        if not entry["services"]:
            err("no services left after filtering - nothing to run")
            sys.exit(1)

    services = entry["services"]

    heading(f"Starting '{args.name}'")

    if scoped:
        _clear_service_state(args.name, [s["name"] for s in services])
    else:
        clear_run_state(args.name)
    _project_state_dir(args.name).mkdir(parents=True, exist_ok=True)

    # -b/--background always means the fallback: both windowed backends
    # (Terminator, and the terminal-emulator backend that replaces tmux) open
    # a GUI window, which is exactly what -b exists to avoid.
    background = getattr(args, "background", False)
    if background:
        run_fallback(args.name, entry, background=True)
        return

    if shutil.which("terminator"):
        backend = "terminator"
    elif resolve_terminal() is not None:
        backend = "terminal"
    else:
        backend = None
    if backend is None:
        # run_fallback is deliberately thin (CLAUDE.md) - it keeps its own
        # sequential prints and label-based spinner rather than going
        # through StatusTable, since there are no panes/session for a
        # dynamic table to describe here anyway.
        run_fallback(args.name, entry, background=False)
        return

    # ONE table for the whole boot, rendered once up front and then updated
    # in place as each service starts (tty) - or printed once now and once
    # more at the end, with plain ok()/err() lines in between (non-tty). See
    # CLAUDE.md's "run control flow".
    animate = sys.stdout.isatty()
    table = StatusTable(services)
    if animate:
        table.draw()
    else:
        table.print_once()

    if backend == "terminator":
        aborted = run_terminator(args.name, entry, table, animate)
        pointer = f"terminator window: sspinner: {args.name}"
    else:
        aborted = run_terminal_windows(args.name, entry, table, animate)
        pointer = f"terminal windows: sspinner: {args.name}"

    if aborted:
        if not animate:
            table.print_once()
        return

    if animate:
        table.set_context(paint(pointer, C.BLUE), animate=True)
    else:
        table.print_once()
        print(paint(pointer, C.BLUE))
    _render_duration_bars(table.durations)
    print(dim("logs: ") + hyperlink(dim(DOZZLE_URL), DOZZLE_URL))


def cmd_stop(args):
    registry = load_registry()
    entry = _require_project(registry, args.name)

    if not teardown_project(args.name, entry):
        sys.exit(1)


def cmd_down(args):
    # Deprecated alias for 'stop' - kept working (hidden from --help and
    # COMMANDS_HELP via argparse.SUPPRESS) so muscle memory and old scripts
    # don't break, but nudges toward the new name. 'infra down' is untouched:
    # that's compose terminology in a different namespace.
    print(dim("'down' is now 'stop'"))
    cmd_stop(args)


def cmd_restart(args):
    # teardown then run, scoped to args.services if given - reuses
    # teardown_project() and cmd_run() unchanged (via _scope_services(), see
    # cmd_run) rather than a second, weaker path that reimplements their
    # verify-and-escalate or boot-order logic for a subset.
    registry = load_registry()
    entry = _require_project(registry, args.name)
    only = args.services or None
    scoped_entry = _scope_services(entry, only=only) if only else entry
    if not teardown_project(args.name, scoped_entry):
        warn("teardown wasn't fully clean - starting anyway")
    cmd_run(argparse.Namespace(
        name=args.name, background=False,
        only=",".join(only) if only else None, except_=None,
    ))


def cmd_logs(args):
    # docker-compose -> 'docker compose logs -f' on the real container;
    # non-docker -> tail -f the log file run_fallback() already writes to
    # (/tmp/sspinner-<project>-<service>.log), currently undiscoverable any
    # other way. os.execvp so Ctrl-C behaves normally, same rationale as
    # cmd_exec(). No service given -> just point at the shared Dozzle viewer.
    registry = load_registry()
    entry = _require_project(registry, args.name)
    if args.service is None:
        print(dim("logs: ") + hyperlink(dim(DOZZLE_URL), DOZZLE_URL))
        return
    svc = _find_service(entry, args.service)
    if svc is None:
        err(f"'{args.service}' isn't a service of '{args.name}'.")
        sys.exit(1)
    if svc["runner"] == "docker-compose":
        os.execvp("docker", [
            "docker", "compose", "-p", svc["compose_project"], "logs", "-f", "--tail", "100",
        ])
        return  # unreachable
    log_path = Path(tempfile.gettempdir()) / f"sspinner-{args.name}-{args.service}.log"
    if not log_path.exists():
        err(f"no log file at {log_path} - '{args.service}' isn't running via 'run -b' "
            "or the sequential fallback")
        sys.exit(1)
    os.execvp("tail", ["tail", "-f", str(log_path)])


_RUNNER_BINARY = {"yarn": "yarn", "pnpm": "pnpm", "npm": "npm", "poetry": "poetry"}


def cmd_doctor(args):
    # Read-only preflight, reports never fixes - same rule teardown follows
    # for a foreign port holder. Checks things that only bite at boot time:
    # docker reachability, which 'run' backend would be picked, and per
    # project per service - the path still exists, a compose file is where
    # a docker-compose service expects one, the runner binary is on $PATH,
    # and the declared port is free or already ours.
    registry = load_registry()
    names = [args.name] if getattr(args, "name", None) else sorted(registry)
    if not names:
        print("No projects registered yet. Run 'sspinner register <name>'.")
        return

    docker_ok = shutil.which("docker") is not None and subprocess.run(
        ["docker", "info"], capture_output=True
    ).returncode == 0
    backend = (
        "terminator" if shutil.which("terminator")
        else "terminal emulator" if resolve_terminal() is not None
        else "sequential fallback (no windows)"
    )
    print(render_table(["check", "result"], [
        ["docker daemon", ("● reachable", C.GREEN) if docker_ok else ("✗ unreachable", C.RED)],
        ["'run' backend", backend],
        ["Dozzle infra", ("● up", C.GREEN) if compose_has_containers(INFRA_PROJECT) else ("○ down", C.DIM)],
    ]))

    for name in names:
        entry = registry.get(name)
        if entry is None:
            err(f"'{name}' isn't registered.")
            continue
        heading(name)
        rows = []
        for svc in entry["services"]:
            path = Path(svc["path"])
            path_ok = path.is_dir()
            path_cell = ("● exists", C.GREEN) if path_ok else ("✗ missing", C.RED)

            if svc["runner"] == "docker-compose":
                has_compose = path_ok and any((path / f).exists() for f in COMPOSE_FILENAMES)
                runner_cell = (
                    ("● compose file found", C.GREEN) if has_compose
                    else ("✗ no compose file", C.RED)
                )
            else:
                binary = _RUNNER_BINARY.get(svc["runner"])
                if binary is None:
                    runner_cell = "-"
                else:
                    runner_cell = (
                        ("● on PATH", C.GREEN) if shutil.which(binary)
                        else (f"✗ '{binary}' not found", C.RED)
                    )

            port = svc.get("port")
            if not port:
                port_cell = "-"
            elif not is_port_open(port):
                port_cell = ("○ free", C.DIM)
            elif service_running(svc, project=name) is True:
                port_cell = ("● ours", C.GREEN)
            else:
                holder = _identify_port_holder(port)
                port_cell = (f"✗ busy ({holder or 'unknown'})", C.RED)

            rows.append([svc["name"], path_cell, runner_cell, port_cell])
        print(render_table(["service", "path", "runner", "port"], rows))


