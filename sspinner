def _compose_containers(svc):
    # Every container (compose service) defined in a service's own compose
    # file, via `docker compose config --services` run from that service's
    # directory - works whether or not the stack is currently up. Returns []
    # on any error so completion (cmd_containers below) degrades to nothing
    # rather than spewing.
    try:
        r = subprocess.run(
            ["docker", "compose", "config", "--services"],
            cwd=svc["path"], capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if r.returncode != 0:
        return []
    return [line.strip() for line in r.stdout.splitlines() if line.strip()]


