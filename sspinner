class _Back:
    # Sentinel returned by allow_back-enabled widgets when the user presses
    # Esc to back out of a question. Distinct from None/"" so it can never be
    # confused with a real (empty-string) answer.
    def __repr__(self):
        return "BACK"


BACK = _Back()


# ------------------------------------------------------------------ styling
class C:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    REVERSE = "\033[7m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    CYAN = "\033[36m"


def _color_ok():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def paint(text, *codes):
    if not _color_ok():
        return text
    return "".join(codes) + text + C.RESET


def _heading_line(text, width=60):
    # The plain text-returning half of heading() (no print, no leading
    # blank) - reused by cmd_list()'s two-column layout to build a heading
    # sized to one column's width instead of the usual ~60, so it can be
    # zipped line-by-line against a second project's block.
    prefix_plain = f"── {text} "
    rule = "─" * max(4, width - len(prefix_plain))
    return paint(f"── {text}", C.BOLD, C.CYAN) + " " + dim(rule)


def heading(text):
    # Lightweight section rule, not a box - boxes are reserved for
    # render_table(). Width of the trailing rule is computed off the plain
    # text first (CLAUDE.md styling rule), so it always lands at ~60 cols
    # regardless of how the title is colorized.
    print("\n" + _heading_line(text))


def ok(text):
    print(paint("  ✓ ", C.GREEN) + text)


def warn(text):
    print(paint("  ! ", C.YELLOW) + text)


def err(text):
    print(paint("  ✗ ", C.RED) + text, file=sys.stderr)


def dim(text):
    return paint(text, C.DIM)


class Link:
    # Marker for a render_table()/paint()ed cell that should be an OSC 8
    # hyperlink to `url` - e.g. ("http://localhost:8080", Link("http://localhost:8080"))
    # or combined with a color: (text, C.GREEN, Link(url)). Applied around
    # the cell's already-padded plain text, same discipline paint() already
    # follows for SGR color codes: wrap after width/truncation, never before.
    __slots__ = ("url",)

    def __init__(self, url):
        self.url = url


def hyperlink(text, url):
    if not _color_ok():
        return text
    return f"\x1b]8;;{url}\x1b\\{text}\x1b]8;;\x1b\\"


_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
_OSC8_RE = re.compile(r"\x1b\]8;;[^\x1b]*\x1b\\")

# Columns that are safe to shrink when a table would otherwise overflow the
# terminal width, in shrink priority order. 'service' and 'status' are never
# shrunk - service is the primary identifier and status is the animated cell.
_SHRINKABLE_COLUMNS = ("detail", "url", "runner")
_MIN_COLUMN_WIDTH = 6


def _visible_len(text):
    # Width off the plain text only - ANSI escape bytes (color AND OSC 8
    # hyperlink wrappers) must never count toward a column's (or a screen
    # row's) width. See CLAUDE.md styling notes.
    return len(_ANSI_RE.sub("", _OSC8_RE.sub("", text)))


def render_table(headers, rows, max_width=None):
    # Cells are either a plain string, or a (text, *paint_codes) tuple for a
    # colored cell. Width is always computed off the plain text so painted
    # ANSI codes never throw off column alignment (see CLAUDE.md styling notes).
    # max_width overrides the live terminal width - used by cmd_list()'s
    # two-column layout to clamp each project's table to half the terminal
    # instead of the whole thing; every other call site leaves it None and
    # gets today's shutil.get_terminal_size() behavior unchanged.
    def cell_text(cell):
        return cell[0] if isinstance(cell, tuple) else cell

    widths = [len(h) for h in headers]
    for row in rows:
        for i, cell in enumerate(row):
            widths[i] = max(widths[i], len(cell_text(cell)))

    def boxed_width(ws):
        # "  " indent + "│ " + cells joined by " │ " + " │"
        return 2 + 2 + sum(ws) + 3 * (len(ws) - 1) + 2

    # Clamp to the terminal's current width: shrink the widest flexible
    # columns a character at a time (cycling through the priority list so no
    # single column bottoms out before its neighbors get a turn) until the
    # whole boxed line fits, or nothing left is shrinkable. This is what
    # actually fixes the corrupted-redraw bug - see _Frame below for the
    # other half (counting screen rows, not logical lines).
    term_width = max_width if max_width is not None else shutil.get_terminal_size().columns
    shrink_idx = [headers.index(h) for h in _SHRINKABLE_COLUMNS if h in headers]
    while shrink_idx and boxed_width(widths) > term_width:
        shrank_any = False
        for i in shrink_idx:
            if widths[i] > _MIN_COLUMN_WIDTH and boxed_width(widths) > term_width:
                widths[i] -= 1
                shrank_any = True
        if not shrank_any:
            break

    def truncate(text, width):
        if len(text) <= width:
            return text
        if width <= 1:
            return text[:width]
        return text[: width - 1] + "…"

    def hline(left, mid, right):
        return left + mid.join("─" * (w + 2) for w in widths) + right

    def render_row(cells, header=False):
        parts = []
        for i, cell in enumerate(cells):
            padded = f"{truncate(cell_text(cell), widths[i]):<{widths[i]}}"
            if header:
                parts.append(paint(padded, C.BOLD, C.CYAN))
            elif isinstance(cell, tuple):
                # A Link marker (see 'class Link' above) is applied after
                # color, not passed to paint() - it isn't an SGR code.
                link = next((c for c in cell[1:] if isinstance(c, Link)), None)
                codes = [c for c in cell[1:] if not isinstance(c, Link)]
                text = paint(padded, *codes) if codes else padded
                parts.append(hyperlink(text, link.url) if link else text)
            else:
                parts.append(padded)
        return "│ " + " │ ".join(parts) + " │"

    lines = [
        "  " + hline("╭", "┬", "╮"),
        "  " + render_row(headers, header=True),
        "  " + hline("├", "┼", "┤"),
    ]
    for row in rows:
        lines.append("  " + render_row(row))
    lines.append("  " + hline("╰", "┴", "╯"))
    return "\n".join(lines)


# --------------------------------------------------------------- registry
def load_registry():
    if not REGISTRY_PATH.exists() and LEGACY_REGISTRY_PATH.exists():
        # One-time migration from the tool's pre-rename config dir. Move, not
        # copy: two live copies would silently diverge the moment either tool
        # name is used to save.
        REGISTRY_PATH.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(LEGACY_REGISTRY_PATH), str(REGISTRY_PATH))
        ok(f"migrated registry from {LEGACY_REGISTRY_PATH} to {REGISTRY_PATH}")
    if not REGISTRY_PATH.exists():
        return {}
    return json.loads(REGISTRY_PATH.read_text())


def save_registry(data):
    REGISTRY_PATH.parent.mkdir(parents=True, exist_ok=True)
    REGISTRY_PATH.write_text(json.dumps(data, indent=2) + "\n")


def slugify(text):
    return re.sub(r"[^a-z0-9-]+", "-", text.lower()).strip("-")


# ------------------------------------------------------------- interactive
# Every widget below renders inline, in the normal screen buffer - never the
# alternate screen (no \x1b[?1049h/smcup, ever). That switch is what made the
# old alternate-screen picker feel like "a new terminal had opened"; these
# widgets instead draw a small block of lines in place, redraw it in place on
# every keystroke, then collapse it to a single one-line summary when done,
# the same way Claude Code's own prompts feel. Every widget also has a plain
# input()-based fallback used whenever stdin/stdout isn't a real tty, so the
# scripted pipe-driven `register` flow described in CLAUDE.md keeps working
# unchanged - same questions, same order, same accepted answers.
def _interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


@contextlib.contextmanager
def _raw_mode(hide_cursor=True):
    # cbreak, not full raw: read one keypress at a time but leave signal
    # processing (Ctrl-C) and output post-processing alone. Always restores
    # the original terminal settings on the way out, including when a
    # KeyboardInterrupt unwinds through the 'with' block.
    fd = sys.stdin.fileno()
    old_settings = termios.tcgetattr(fd)
    if hide_cursor:
        sys.stdout.write("\x1b[?25l")
        sys.stdout.flush()
    try:
        tty.setcbreak(fd)
        yield
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
        if hide_cursor:
            sys.stdout.write("\x1b[?25h")
            sys.stdout.flush()


_ARROW_KEYS = {"A": "up", "B": "down", "C": "right", "D": "left"}


def _read_one(fd):
    # Unbuffered single-byte read straight off the fd via os.read(), not
    # sys.stdin.read(). TextIOWrapper's own internal buffering can silently
    # slurp more bytes than requested from the OS on one call, so a later
    # select() on the raw fd sees nothing pending even though a full escape
    # sequence is already sitting in Python's buffer - that mismatch is what
    # breaks arrow-key detection below if sys.stdin.read(1) is used instead.
    return os.read(fd, 1).decode(errors="replace")


def _read_key():
    # Decodes one keypress to a symbolic name where it makes sense (arrow
    # keys, tab, enter, backspace, esc), otherwise returns the raw printable
    # character. A bare Esc and the start of an arrow-key escape sequence
    # both begin with \x1b, so a short select() timeout is used to tell them
    # apart without blocking forever on a lone Esc press.
    fd = sys.stdin.fileno()
    ch = _read_one(fd)
    if ch == "\x03":
        raise KeyboardInterrupt
    if ch == "\x1b":
        ready, _, _ = select.select([fd], [], [], 0.05)
        if not ready:
            return "esc"
        ch2 = _read_one(fd)
        if ch2 != "[":
            return "esc"
        ch3 = _read_one(fd)
        return _ARROW_KEYS.get(ch3, "esc")
    if ch in ("\r", "\n"):
        return "enter"
    if ch == "\t":
        return "tab"
    if ch in ("\x7f", "\x08"):
        return "backspace"
    return ch


def _fit_segments(segments, width=None):
    # segments: [(plain_text, paint_codes_or_None), ...]. Truncation happens
    # on the plain text *before* colorizing (same rule render_table() follows
    # per CLAUDE.md styling notes), and the running width is clamped to the
    # terminal's current column count so a wrapped line can never corrupt the
    # redraw math in _Frame below.
    if width is None:
        width = shutil.get_terminal_size().columns
    out = []
    used = 0
    for text, codes in segments:
        remaining = width - used
        if remaining <= 0:
            break
        if len(text) > remaining:
            text = text[:remaining]
        used += len(text)
        out.append(paint(text, *codes) if codes else text)
    return "".join(out)


class _Frame:
    # Tracks how many SCREEN ROWS the widget's previous draw used, so the
    # next draw can move the cursor back up over exactly that many rows
    # (\x1b[<n>A + \r) and erase everything below (\x1b[J) before reprinting,
    # rather than scrolling the screen on every keystroke. This must be
    # screen rows, not logical lines: a line wider than the terminal wraps to
    # more than one row, and moving up by line-count instead of row-count is
    # exactly what made a wide StatusTable scroll forever on an 80-column
    # terminal instead of redrawing in place - see render_table()'s width
    # clamp for the other half of that fix. Width is re-read on every render
    # since a terminal can be resized mid-boot.
    def __init__(self):
        self.count = 0

    def _rows_for(self, lines):
        columns = shutil.get_terminal_size().columns
        return sum(max(1, math.ceil(_visible_len(line) / columns)) for line in lines)

    def render(self, lines):
        if self.count:
            sys.stdout.write(f"\x1b[{self.count}A\r\x1b[J")
        sys.stdout.write("\n".join(lines) + "\n")
        sys.stdout.flush()
        self.count = self._rows_for(lines)

    def collapse(self, summary_line):
        # The signature "finished" move: erase the whole region and leave a
        # single one-line summary behind (green check + dim question +
        # normal-weight answer).
        if self.count:
            sys.stdout.write(f"\x1b[{self.count}A\r\x1b[J")
        sys.stdout.write(summary_line + "\n")
        sys.stdout.flush()
        self.count = 0

    def clear(self):
        # The "backed out" move: erase the whole region and leave nothing
        # behind - used when Esc backs out of a question rather than
        # answering it, so no summary line is left to imply an answer given.
        if self.count:
            sys.stdout.write(f"\x1b[{self.count}A\r\x1b[J")
            sys.stdout.flush()
        self.count = 0


def _collapse_line(question, answer):
    return f"{paint('✓', C.GREEN)} {dim(question)} · {answer}"


def ask(prompt, default=None, required=False, allow_back=False):
    if not _interactive():
        return _ask_plain(prompt, default=default, required=required)
    if allow_back:
        return _ask_with_back(prompt, default=default, required=required)
    width = shutil.get_terminal_size().columns
    hint = f" (default: {default})" if default is not None else ""
    question_line = _fit_segments(
        [("◆ ", (C.BLUE,)), (prompt, (C.BOLD,)), (hint, (C.DIM,))], width
    )
    frame = _Frame()
    error_line = None
    while True:
        lines = [question_line]
        if error_line:
            lines.append(error_line)
        frame.render(lines)
        # Plain input() (cooked mode) is fine here - readline-style editing
        # isn't required, and cooked mode is what lets backspace/line-editing
        # work for free while typing.
        raw = input("  ").strip()
        frame.count += 1  # account for the line input() itself just echoed
        if not raw and default is not None:
            answer = default
            break
        if not raw and required:
            error_line = dim("    required, try again")
            continue
        answer = raw
        break
    frame.collapse(_collapse_line(prompt, answer))
    return answer


def _ask_with_back(prompt, default=None, required=False):
    # allow_back=True variant of ask(): cooked input() can't be interrupted
    # mid-line to detect Esc, so this drives its own raw-mode line editor
    # instead - printable chars append (and are echoed via re-render),
    # Backspace edits, Enter submits with the same default/required
    # semantics as the cooked path, Esc returns BACK. Cursor stays visible
    # (unlike other raw-mode widgets) since the user is typing free text.
    width = shutil.get_terminal_size().columns
    hint = f" (default: {default})" if default is not None else ""
    back_hint = " (esc to go back)"
    buffer = ""
    error_line = None
    frame = _Frame()
    with _raw_mode(hide_cursor=False):
        while True:
            question_line = _fit_segments(
                [("◆ ", (C.BLUE,)), (prompt, (C.BOLD,)), (hint, (C.DIM,)), (back_hint, (C.DIM,))],
                width,
            )
            input_line = _fit_segments([("  ", None), (buffer, None)], width)
            lines = [question_line, input_line]
            if error_line:
                lines.append(error_line)
            frame.render(lines)

            key = _read_key()
            if key == "esc":
                frame.clear()
                return BACK
            if key == "enter":
                if not buffer and default is not None:
                    answer = default
                    break
                if not buffer and required:
                    error_line = dim("    required, try again")
                    continue
                answer = buffer
                break
            if key == "backspace":
                buffer = buffer[:-1]
                error_line = None
            elif len(key) == 1 and key.isprintable():
                buffer += key
                error_line = None
    frame.collapse(_collapse_line(prompt, answer))
    return answer


def _ask_plain(prompt, default=None, required=False):
    suffix = f" [{default}]" if default is not None else ""
    while True:
        raw = input(paint(f"  {prompt}{suffix}: ", C.BOLD)).strip()
        if not raw and default is not None:
            return default
        if not raw and required:
            print(dim("    required, try again"))
            continue
        return raw


def ask_int(prompt, default=None):
    while True:
        raw = ask(prompt, default=str(default) if default is not None else None)
        try:
            return int(raw)
        except ValueError:
            print(dim("    not a number, try again"))


def ask_optional_int(prompt, default=None):
    raw = ask(prompt, default=str(default) if default is not None else "")
    if not raw:
        return None
    try:
        return int(raw)
    except ValueError:
        print(dim("    not a number, skipping"))
        return None


def ask_yes_no(prompt, default=True, allow_back=False):
    if not _interactive():
        return _ask_yes_no_plain(prompt, default)
    width = shutil.get_terminal_size().columns
    selected = default
    frame = _Frame()
    back_hint = " (esc to go back)" if allow_back else ""

    def render_line():
        if selected:
            yes, no = ("❯ Yes", (C.BOLD, C.BLUE)), ("  No", (C.DIM,))
        else:
            yes, no = ("  Yes", (C.DIM,)), ("❯ No", (C.BOLD, C.BLUE))
        return _fit_segments(
            [("◆ ", (C.BLUE,)), (prompt, (C.BOLD,)), ("   ", None), yes, ("    ", None), no,
             (back_hint, (C.DIM,))],
            width,
        )

    with _raw_mode():
        while True:
            frame.render([render_line()])
            key = _read_key()
            if key in ("left", "right", "tab"):
                selected = not selected
            elif key in ("y", "Y"):
                selected = True
            elif key in ("n", "N"):
                selected = False
            elif key == "enter":
                break
            elif key == "esc" and allow_back:
                frame.clear()
                return BACK
    frame.collapse(_collapse_line(prompt, "Yes" if selected else "No"))
    return selected


def _ask_yes_no_plain(prompt, default=True):
    suffix = "Y/n" if default else "y/N"
    while True:
        raw = input(paint(f"  {prompt} [{suffix}]: ", C.BOLD)).strip().lower()
        if not raw:
            return default
        if raw in ("y", "yes"):
            return True
        if raw in ("n", "no"):
            return False


def ask_choice(prompt, options, allow_back=False):
    if not _interactive():
        return _ask_choice_plain(prompt, options)
    width = shutil.get_terminal_size().columns
    back_hint = " (esc to go back)" if allow_back else ""
    question_line = _fit_segments(
        [("◆ ", (C.BLUE,)), (prompt, (C.BOLD,)), (back_hint, (C.DIM,))], width
    )
    selected = 0
    frame = _Frame()
    with _raw_mode():
        while True:
            lines = [question_line]
            for i, opt in enumerate(options):
                if i == selected:
                    lines.append(_fit_segments([("  ❯ ", (C.BLUE,)), (opt, (C.BOLD,))], width))
                else:
                    lines.append(_fit_segments([(f"    {opt}", (C.DIM,))], width))
            frame.render(lines)
            key = _read_key()
            if key == "up":
                selected = (selected - 1) % len(options)
            elif key == "down":
                selected = (selected + 1) % len(options)
            elif key.isdigit() and key != "0" and int(key) <= len(options):
                selected = int(key) - 1
            elif key == "enter":
                break
            elif key == "esc" and allow_back:
                frame.clear()
                return BACK
    frame.collapse(_collapse_line(prompt, options[selected]))
    return options[selected]


def _ask_choice_plain(prompt, options):
    print(paint(f"  {prompt}", C.BOLD))
    for i, opt in enumerate(options, 1):
        print(f"    {i}) {opt}")
    while True:
        raw = input(paint("  > ", C.BOLD)).strip()
        if raw.isdigit() and 1 <= int(raw) <= len(options):
            return options[int(raw) - 1]
        print(dim(f"    enter a number 1-{len(options)}"))


def _ask_path_plain(prompt, default=None):
    while True:
        raw = ask(prompt, default=default, required=True)
        path = Path(raw).expanduser().resolve()
        if path.is_dir():
            return str(path)
        print(dim(f"    '{path}' isn't a directory, try again"))


def _path_suggestions(buffer, limit=10):
    expanded = os.path.expanduser(buffer) if buffer else str(Path.cwd())
    if not buffer or buffer.endswith("/"):
        base, prefix = expanded, ""
    else:
        base, prefix = os.path.split(expanded)
        base = base or "."
    try:
        entries = sorted(
            p for p in Path(base).iterdir()
            if p.is_dir()
            and p.name.startswith(prefix)
            and (prefix.startswith(".") or not p.name.startswith("."))
        )
    except OSError:
        entries = []
    return base, entries[:limit]


def ask_path(prompt, default=None):
    # Single prompt line with up to 8 suggestion lines below, redrawn on
    # every keystroke - the inline replacement for the old alternate-screen dropdown.
    # Falls back to the plain input()-based picker when there's no real
    # terminal to draw into.
    if not _interactive():
        return _ask_path_plain(prompt, default)

    width = shutil.get_terminal_size().columns
    buffer = default or ""
    highlighted = 0
    error = None
    path = None
    frame = _Frame()

    with _raw_mode():
        while True:
            base, suggestions = _path_suggestions(buffer)
            highlighted = max(0, min(highlighted, len(suggestions) - 1)) if suggestions else 0

            lines = [
                _fit_segments(
                    [("◆ ", (C.BLUE,)), (f"{prompt} ", (C.BOLD,)), (buffer, None)], width
                )
            ]
            if error:
                lines.append(_fit_segments([(f"    {error}", (C.RED,))], width))
                error = None
            for i, suggestion in enumerate(suggestions[:8]):
                text = f"    {suggestion}/"
                if i == highlighted:
                    lines.append(_fit_segments([(text, (C.BLUE, C.REVERSE))], width))
                else:
                    lines.append(_fit_segments([(text, (C.DIM,))], width))
            lines.append(_fit_segments(
                [("    type to filter · ↑↓ select · tab descend · enter confirm", (C.DIM,))],
                width,
            ))
            frame.render(lines)

            key = _read_key()
            if key == "up" and suggestions:
                highlighted = (highlighted - 1) % len(suggestions)
            elif key == "down" and suggestions:
                highlighted = (highlighted + 1) % len(suggestions)
            elif key == "tab" and suggestions:
                buffer = str(suggestions[highlighted]) + "/"
                highlighted = 0
            elif key == "enter":
                candidate = buffer
                expanded_candidate = os.path.expanduser(candidate)
                if not os.path.isdir(expanded_candidate) and suggestions:
                    candidate = str(suggestions[highlighted])
                    expanded_candidate = candidate
                candidate_path = Path(expanded_candidate).resolve()
                if candidate_path.is_dir():
                    path = candidate_path
                    break
                error = f"'{candidate}' isn't a directory, try again"
            elif key == "backspace":
                buffer = buffer[:-1]
                highlighted = 0
            elif key == "esc":
                buffer = ""
                highlighted = 0
            elif len(key) == 1 and key.isprintable():
                buffer += key
                highlighted = 0

    frame.collapse(_collapse_line("path", str(path)))
    return str(path)


# ------------------------------------------------------------- run helpers
_SPINNER_FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"


def wait_for_port(port, timeout=120, host="localhost", label=None, tick=None,
                   rcfile=None, allow_skip=False):
    # Returns one of "up" / "timeout" / "exited" / "skipped" / "aborted" -
    # richer than the old True/False, so a caller can tell a genuine timeout
    # apart from the service's own command dying, or the user backing out.
    # label=None (or a non-tty stdout) keeps this exactly as silent/plain as
    # before - callers print their own ok()/err() line once this returns.
    # When a label is given on a real terminal, animate a one-line spinner in
    # place (redrawn with \r\x1b[K) so waiting doesn't look like a hang; the
    # line is cleared before returning either way so the caller's line lands
    # clean. tick=None keeps this whole path's original connect-attempt
    # timing unchanged from before tick/rcfile/allow_skip existed.
    #
    # rcfile, if given, is build_pane_command()'s '<pidfile>.rc' sibling -
    # its appearance means the service's own command has already exited
    # (successfully or not), so there's no point waiting out the rest of
    # `timeout` for a port that's never going to open. Checked on the same
    # cadence as the connect attempts in both branches below.
    animate = label is not None and sys.stdout.isatty()
    deadline = time.time() + timeout
    start = time.time()
    frame_i = 0

    def exited():
        return rcfile is not None and rcfile.exists()

    def clear_line():
        if animate:
            sys.stdout.write("\r\x1b[K")
            sys.stdout.flush()

    if tick is None:
        while time.time() < deadline:
            if exited():
                clear_line()
                return "exited"
            try:
                with socket.create_connection((host, port), timeout=2):
                    clear_line()
                    return "up"
            except OSError:
                if animate:
                    elapsed = int(time.time() - start)
                    spinner = _SPINNER_FRAMES[frame_i % len(_SPINNER_FRAMES)]
                    frame_i += 1
                    text = f"{spinner} waiting for {label} on :{port} ({elapsed}s)"
                    sys.stdout.write("\r\x1b[K" + paint(text, C.DIM))
                    sys.stdout.flush()
                time.sleep(1)
        clear_line()
        return "timeout"

    # tick given: a caller (StatusTable's per-service spinner cell) wants
    # smooth ~4/s updates even though the actual TCP connect attempts still
    # only retry ~once/s - so the connect itself is throttled by
    # next_attempt while the outer loop wakes every ~0.25s to call tick(),
    # check the exit marker, and (if allow_skip) poll for an 's'/'q'
    # keypress. allow_skip puts stdin in cbreak mode for the duration of
    # this call (via _raw_mode(), the same primitive the registration
    # widgets use) so a single keypress is seen without Enter; Ctrl-C still
    # works since cbreak leaves signal processing alone.
    key_ctx = (
        _raw_mode(hide_cursor=False)
        if allow_skip and sys.stdin.isatty()
        else contextlib.nullcontext()
    )
    next_attempt = start
    with key_ctx:
        while time.time() < deadline:
            if allow_skip and sys.stdin.isatty() and select.select([sys.stdin], [], [], 0)[0]:
                key = _read_one(sys.stdin.fileno())
                if key in ("s", "S"):
                    clear_line()
                    return "skipped"
                if key in ("q", "Q"):
                    clear_line()
                    return "aborted"
            if exited():
                clear_line()
                return "exited"
            now = time.time()
            if now >= next_attempt:
                try:
                    with socket.create_connection((host, port), timeout=2):
                        clear_line()
                        return "up"
                except OSError:
                    next_attempt = time.time() + 1
            elapsed = time.time() - start
            spinner = _SPINNER_FRAMES[frame_i % len(_SPINNER_FRAMES)]
            frame_i += 1
            tick(spinner, elapsed)
            if animate:
                text = f"{spinner} waiting for {label} on :{port} ({int(elapsed)}s)"
                sys.stdout.write("\r\x1b[K" + paint(text, C.DIM))
                sys.stdout.flush()
            time.sleep(0.25)
    clear_line()
    return "timeout"


def _check_early_exit(rcfile, seconds=2):
    # Best-effort fail-fast for a service with no port to poll: give its
    # command a couple of seconds to prove it's still alive before reporting
    # 'started' - catches an instantly-failing command (typo'd binary, bad
    # script name) without turning a fire-and-forget no-port service into
    # something run blocks on indefinitely.
    if rcfile is None:
        return False
    deadline = time.time() + seconds
    while time.time() < deadline:
        if rcfile.exists():
            return True
        time.sleep(0.25)
    return False


def is_port_open(port, host="localhost"):
    try:
        with socket.create_connection((host, port), timeout=0.5):
            return True
    except OSError:
        return False


def wait_for_port_free(port, timeout=5, tick=None):
    # The teardown-side twin of wait_for_port(): polls until the port stops
    # answering, or the timeout elapses. Used by teardown_project() so a
    # service is only ever reported '○ stopped' once its port has actually
    # been released, not just because 'docker compose down' or a SIGTERM
    # returned.
    start = time.time()
    deadline = start + timeout
    frame_i = 0
    while time.time() < deadline:
        if not is_port_open(port, host="localhost"):
            return True
        if tick is not None:
            tick(_SPINNER_FRAMES[frame_i % len(_SPINNER_FRAMES)], time.time() - start)
            frame_i += 1
        time.sleep(0.25)
    return not is_port_open(port, host="localhost")


def compose_has_containers(compose_project):
    r = subprocess.run(
        ["docker", "compose", "-p", compose_project, "ps", "-q"],
        capture_output=True, text=True,
    )
    return bool(r.stdout.strip())


_running_compose_projects_cache = None


def _running_compose_projects():
    # Every docker-compose project currently running, from one `docker ps`
    # call - cached per process. 'list' used to shell out to
    # compose_has_containers() once per docker-compose service; this
    # collapses that to one call regardless of how many projects/services
    # are registered. compose_has_containers() stays as its own thing for
    # teardown_project()'s verify-and-escalate loop, which needs a fresh
    # single-project read after each 'down' attempt, not a cached snapshot.
    global _running_compose_projects_cache
    if _running_compose_projects_cache is None:
        r = subprocess.run(
            ["docker", "ps", "--format", '{{.Label "com.docker.compose.project"}}'],
            capture_output=True, text=True,
        )
        _running_compose_projects_cache = {
            line.strip() for line in r.stdout.splitlines() if line.strip()
        }
    return _running_compose_projects_cache


def _service_state(svc, project=None):
    # Single source of truth for "what is this service actually doing right
    # now" - service_running() and _status_cell() below are both thin views
    # over this. Order of evidence matters: for a docker-compose service,
    # compose-project membership is checked FIRST and is authoritative. A
    # port number is not unique across registered projects (this machine's
    # 'lawial' and 'dayeaty' both declare :8080 for keycloak) - checking the
    # port first would paint a stopped project 'running' whenever a
    # same-numbered port happens to be answering for someone else.
    # 'project' is the sspinner project name (not svc['compose_project']),
    # needed to look up this service's own tracked pidfile; omit it and the
    # non-docker branches degrade to their old, less specific answers.
    if svc["runner"] == "docker-compose":
        if svc["compose_project"] not in _running_compose_projects():
            return "stopped"
        port = svc.get("port")
        if port and not is_port_open(port):
            return "starting"
        return "running"

    pid = _read_pid(_pidfile_path(project, svc["name"])) if project else None
    tracked_alive = pid is not None and _pid_belongs_to(pid, svc["path"]) and _pid_alive(pid)
    port = svc.get("port")
    if port:
        if not is_port_open(port):
            return "stopped"
        if pid is not None and not tracked_alive:
            return "foreign"  # port answers, but our own tracked process is dead
        return "running"
    return "running" if tracked_alive else "unknown"


def _tracked_pid_alive(project, svc):
    pid = _read_pid(_pidfile_path(project, svc["name"]))
    return pid is not None and _pid_belongs_to(pid, svc["path"]) and _pid_alive(pid)


def service_running(svc, project=None):
    # True/False/None view of _service_state(), for call sites that only
    # need a boolean (skip-relaunch checks, running_projects()). 'starting'
    # counts as running for these purposes - a compose project mid-boot
    # still means "don't try to start this again".
    state = _service_state(svc, project)
    if state in ("running", "starting"):
        return True
    if state == "stopped":
        return False
    return None  # foreign or unknown - genuinely ambiguous


def _status_cell(svc, project=None):
    return {
        "running": ("● running", C.GREEN),
        "starting": ("◐ starting", C.YELLOW),
        "stopped": ("○ stopped", C.DIM),
        "foreign": ("◑ foreign", C.YELLOW),
        "unknown": ("○ unknown", C.DIM),
    }[_service_state(svc, project)]


def build_pane_command(svc, pidfile=None):
    # pidfile, if given, is prefixed as `echo $$ > "<pidfile>"; ` - the one
    # mechanism shared by every backend (Terminator, the terminal-emulator
    # backend, and the sequential fallback) for `stop` to later find and kill
    # the pane's process group. $$ survives the trailing `exec bash` (same
    # pid takes over the shell), so the file stays valid for the pane's life.
    # A pidfile also gets a '.rc' sibling written right after the service's
    # own command exits (`echo $? > "<pidfile>.rc"`) - that's what
    # wait_for_port()'s rcfile param polls for to detect a service dying
    # almost instantly, instead of waiting out the full port timeout.
    path = svc["path"]
    runner = svc["runner"]
    if runner == "docker-compose":
        build = "--build" if svc.get("build", True) else ""
        project = svc["compose_project"]
        inner = (
            f'cd "{path}" && docker compose -p "{project}" up -d {build} '
            f'&& docker compose -p "{project}" logs -f --tail 100'
        )
    elif runner in ("yarn", "pnpm"):
        script = svc.get("script", "dev")
        inner = f'cd "{path}" && {runner} {script}'
    elif runner == "npm":
        script = svc.get("script", "dev")
        inner = f'cd "{path}" && npm run {script}'
    elif runner == "poetry":
        inner = f'cd "{path}" && poetry run {svc["command"]}'
    elif runner == "custom":
        inner = f'cd "{path}" && {svc["command"]}'
    else:
        raise ValueError(f"unknown runner {runner!r}")
    if pidfile is not None:
        return f'echo $$ > "{pidfile}"; {inner}; echo $? > "{pidfile}.rc"; exec bash'
    return f'{inner}; exec bash'


class _BootAborted(Exception):
    # Raised by _poll_service_boot() when the user presses 'q' during a
    # wait, caught by run_terminal_windows()/run_terminator() to stop
    # walking the rest of the boot order.
    pass


def _read_rc(rcfile):
    try:
        return int(rcfile.read_text().strip())
    except (OSError, ValueError):
        return "?"


def _preflight_port(project, svc, table, animate):
    # Checked right before this service's own command is launched - only
    # meaningful for a backend that launches sequentially. run_terminator's
    # whole grid launches in one Popen call before its per-service loop even
    # starts, so it can't offer this; see run_terminator()'s own comment. A
    # foreign holder is reported, never killed - same rule teardown already
    # follows for a port that's still open after 'down'.
    #
    # Deliberately stricter than service_running()/_service_state(): those
    # degrade to "assume it's ours" when there's no pidfile to check (fine
    # for a read-only status display), but a pre-launch gate needs the
    # opposite default - no positive evidence of a live tracked process
    # means don't assume it's safe to skip past.
    port = svc.get("port")
    if not port or not is_port_open(port):
        return True
    ours = (
        svc["compose_project"] in _running_compose_projects()
        if svc["runner"] == "docker-compose"
        else _tracked_pid_alive(project, svc)
    )
    if ours:
        return True
    holder = _identify_port_holder(port)
    hint = f" (held by {holder})" if holder else " (couldn't identify what's holding it)"
    table.set_status(svc["name"], (f"✗ port {port} busy", C.RED), animate=animate)
    if not animate:
        err(f"port {port} for {svc['name']} is already in use{hint} - not starting it")
    return False


def _poll_service_boot(project, svc, table, animate, i, total):
    # Shared 'mark starting, wait, report the outcome' step for
    # run_terminal_windows() and run_terminator() - the only difference
    # between the two backends is how the pane/window gets launched before
    # this runs. Raises _BootAborted if the user presses 'q' during the wait.
    svc_name = svc["name"]
    port = svc.get("port")
    table.set_status(svc_name, (f"{_SPINNER_FRAMES[0]} starting (0s)", C.YELLOW), animate=animate)
    table.set_context(
        dim(f"{_SPINNER_FRAMES[0]} starting {svc_name} ({i + 1}/{total}) · s skip · q abort"),
        animate=animate,
    )
    rcfile = _rcfile_path(project, svc_name)

    if not port:
        if _check_early_exit(rcfile):
            code = _read_rc(rcfile)
            table.set_status(svc_name, (f"✗ exited ({code})", C.RED), animate=animate)
            if not animate:
                err(f"{svc_name} exited ({code}) before it could start")
        else:
            table.set_status(svc_name, ("● started", C.GREEN), animate=animate)
        return

    def tick(spinner, elapsed, svc_name=svc_name, i=i):
        table.set_status(svc_name, (f"{spinner} starting ({int(elapsed)}s)", C.YELLOW), animate=True)
        table.set_context(
            dim(f"{spinner} starting {svc_name} ({i + 1}/{total}) · s skip · q abort"), animate=True
        )

    boot_start = time.time()
    outcome = wait_for_port(port, tick=tick if animate else None, rcfile=rcfile, allow_skip=animate)
    elapsed = time.time() - boot_start
    if outcome == "up":
        table.set_status(svc_name, (f"● running {elapsed:.1f}s", C.GREEN), animate=animate)
        table.durations[svc_name] = elapsed
        if not animate:
            ok(f"{svc_name} is up on :{port} ({elapsed:.1f}s)")
    elif outcome == "exited":
        code = _read_rc(rcfile)
        table.set_status(svc_name, (f"✗ exited ({code})", C.RED), animate=animate)
        if not animate:
            err(f"{svc_name} exited ({code}) before it came up on :{port}")
    elif outcome == "skipped":
        table.set_status(svc_name, ("⊘ skipped", C.DIM), animate=animate)
    elif outcome == "aborted":
        table.set_status(svc_name, ("⊘ skipped", C.DIM), animate=animate)
        raise _BootAborted()
    else:  # "timeout"
        table.set_status(svc_name, ("✗ timeout", C.RED), animate=animate)
        if not animate:
            err(f"timed out waiting for {svc_name} on :{port}")


_DURATION_BAR_WIDTH = 24
_DURATION_BAR_CHAR = "▇"


def _render_duration_bars(durations):
    # A relative-duration bar per service that actually finished booting, in
    # boot order - the elapsed times _poll_service_boot() already computes
    # for its '● running <N.Ns>' status cells, kept on the table instead of
    # thrown away once painted. Needs at least two data points to be
    # "relative" to anything; a single service (or none) prints nothing.
    if len(durations) < 2:
        return
    max_elapsed = max(durations.values())
    name_width = max(len(name) for name in durations)
    print(dim("\n  boot time"))
    for name, elapsed in durations.items():
        filled = max(1, round((elapsed / max_elapsed) * _DURATION_BAR_WIDTH)) if max_elapsed > 0 else 0
        bar = paint(_DURATION_BAR_CHAR * filled, C.BLUE)
        print(f"  {name:<{name_width}}  {bar}  {elapsed:.1f}s")


class StatusTable:
    # Owns the single dynamic service/runner/detail/url/status table that
    # cmd_run renders once and updates in place as the boot progresses
    # (replaces the old three-tables-plus-per-service-headings flow - see
    # CLAUDE.md's "run control flow"). Backends (run_terminator/
    # run_terminal_windows) never print their own headings or ok()/err()
    # lines for a service's progress on a tty; they just call
    # set_status()/set_context() here and
    # cmd_run owns when/whether that actually redraws (animate=True on a
    # real tty via _Frame, or left as a silent state update otherwise so the
    # non-tty path can print the table exactly twice - once up front, once
    # at the end - per CLAUDE.md).
    HEADERS = ["service", "runner", "detail", "url", "status"]

    def __init__(self, services, project=None):
        self.services = services
        self.project = project
        self.statuses = {svc["name"]: ("○ queued", C.DIM) for svc in services}
        self.context = None
        self.frame = _Frame()
        # Boot durations for services that actually came up, in boot order -
        # kept around (not thrown away after painting the '● running <N.Ns>'
        # cell) so a post-boot summary can show them. See
        # _render_duration_bars().
        self.durations = {}

    def _name_cell(self, svc):
        # Bold the service name while its status cell is actively ticking (a
        # spinner-frame prefix, shared by 'starting' and 'stopping' cells
        # alike) - with several rows the eye finds the one actually moving
        # without hunting through otherwise identical-looking queued/stopped
        # rows for the spinner. Shared by StatusTable and StopTable's _row().
        status_text = self.statuses[svc["name"]][0]
        if status_text and status_text[0] in _SPINNER_FRAMES:
            return (svc["name"], C.BOLD)
        return svc["name"]

    def _row(self, svc):
        # One row per service; subclasses override this (plus HEADERS) for a
        # different column set - the frame/redraw machinery below is shared,
        # never duplicated (see StopTable).
        detail = svc.get("compose_project") or svc.get("script") or svc.get("command", "") or "-"
        url = f"http://localhost:{svc['port']}" if svc.get("port") else "-"
        return [self._name_cell(svc), svc["runner"], detail, url, self.statuses[svc["name"]]]

    def _rows(self):
        return [self._row(svc) for svc in self.services]

    def _table_text(self):
        return render_table(self.HEADERS, self._rows())

    def draw(self):
        # tty redraw-in-place, via the shared _Frame convention (cursor back
        # up + erase + reprint) rather than scrolling a new table every tick.
        lines = self._table_text().split("\n")
        if self.context:
            lines.append(self.context)
        self.frame.render(lines)

    def print_once(self):
        # non-tty (or a one-shot final snapshot): plain print, no cursor
        # movement escapes at all.
        print(self._table_text())

    def set_status(self, name, cell, animate):
        self.statuses[name] = cell
        if animate:
            self.draw()

    def set_context(self, text, animate):
        self.context = text
        if animate:
            self.draw()


class StopTable(StatusTable):
    # teardown_project's variant of the run view: no url column (meaningless
    # while tearing down), and initial statuses reflect each service's real
    # _status_cell() state instead of "queued". Everything else -
    # _Frame redraw, context line, set_status/set_context - is inherited.
    HEADERS = ["service", "runner", "detail", "status"]

    def __init__(self, services, project):
        super().__init__(services, project=project)
        for svc in services:
            self.statuses[svc["name"]] = _status_cell(svc, project=project)

    def _row(self, svc):
        detail = svc.get("compose_project") or svc.get("script") or svc.get("command", "") or "-"
        return [self._name_cell(svc), svc["runner"], detail, self.statuses[svc["name"]]]


def ensure_network(name):
    r = subprocess.run(["docker", "network", "inspect", name], capture_output=True)
    if r.returncode != 0:
        ok(f"creating shared docker network '{name}'")
        subprocess.run(["docker", "network", "create", name], check=True)


RUN_STATE_DIR = Path.home() / ".config" / "sspinner" / "running"
# Pid tracking, one file per service (running/<project>/<service>.pid). This
# is what lets `stop` kill non-docker services now that there's no tmux
# session whose death took every pane process down with it - see
# CLAUDE.md's "run control flow" and "stop" sections. State, not code: same
# rule as the registry, never checked into this repo.


def _project_state_dir(project):
    return RUN_STATE_DIR / project


def _pidfile_path(project, svc_name):
    return _project_state_dir(project) / f"{svc_name}.pid"


def _rcfile_path(project, svc_name):
    # build_pane_command()'s '.rc' sibling of the pidfile - see its comment
    # for what writes it and wait_for_port()'s rcfile param for what reads it.
    return Path(f"{_pidfile_path(project, svc_name)}.rc")


def clear_run_state(project):
    shutil.rmtree(_project_state_dir(project), ignore_errors=True)


def _clear_service_state(project, service_names):
    # Scoped twin of clear_run_state(): removes just the pidfile (+ '.rc'
    # sibling) for the given services, rather than the whole project run
    # directory - used by 'run --only/--except' and 'restart' so pidfiles
    # for services outside the current scope (which might still be tracked
    # as running from an earlier full run) aren't destroyed out from under a
    # later 'stop'. A full unscoped 'run' still uses clear_run_state() above,
    # since 'stop' expects the whole run directory gone afterward.
    for svc_name in service_names:
        _pidfile_path(project, svc_name).unlink(missing_ok=True)
        _rcfile_path(project, svc_name).unlink(missing_ok=True)


def _read_pid(pidfile):
    try:
        return int(pidfile.read_text().strip())
    except (OSError, ValueError):
        return None


def _pid_belongs_to(pid, path):
    # Cheap guard against pid reuse: confirm the process this pid points to
    # still looks like the one sspinner started, by checking its cmdline
    # mentions the service's own directory.
    try:
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        return False
    return path.encode() in cmdline


def _pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def kill_tracked_process(project, svc_name, svc_path, tick=None):
    # Verify-then-escalate: SIGTERM the process group, give it a few seconds,
    # SIGKILL if it's still around. Returns True if something was actually
    # killed (or was already gone), False if the pidfile was stale/missing.
    # tick(spinner, elapsed), if given, is called on the same ~0.25s cadence
    # wait_for_port() uses, so callers can animate a status cell while this
    # blocks - see StopTable's per-service spinner in teardown_project().
    pidfile = _pidfile_path(project, svc_name)
    pid = _read_pid(pidfile)
    if pid is None:
        return False
    if not _pid_belongs_to(pid, svc_path):
        pidfile.unlink(missing_ok=True)
        return False

    def wait_while_alive(seconds, start):
        frame_i = 0
        deadline = time.time() + seconds
        while _pid_alive(pid) and time.time() < deadline:
            if tick is not None:
                tick(_SPINNER_FRAMES[frame_i % len(_SPINNER_FRAMES)], time.time() - start)
                frame_i += 1
            time.sleep(0.25)

    try:
        pgid = os.getpgid(pid)
        os.killpg(pgid, signal.SIGTERM)
    except OSError:
        pidfile.unlink(missing_ok=True)
        return True  # already gone

    start = time.time()
    wait_while_alive(5, start)
    if _pid_alive(pid):
        try:
            os.killpg(pgid, signal.SIGKILL)
        except OSError:
            pass
        wait_while_alive(2, start)
    pidfile.unlink(missing_ok=True)
    return True


def _identify_port_holder(port):
    # Best-effort: who's answering on this port, so a "still in use" message
    # can name a pid instead of just failing silently. Degrades to None (a
    # plain "couldn't identify" note) if ss/lsof are missing or give nothing -
    # never treated as fatal, this is purely informational.
    try:
        r = subprocess.run(
            ["ss", "-ltnp", f"sport = :{port}"],
            capture_output=True, text=True, timeout=3,
        )
        match = re.search(r'\(\("([^"]+)",pid=(\d+)', r.stdout)
        if match:
            return f"{match.group(1)} (pid {match.group(2)})"
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        r = subprocess.run(
            ["lsof", "-ti", f":{port}"], capture_output=True, text=True, timeout=3,
        )
        pids = r.stdout.split()
        if pids:
            return f"pid {pids[0]}"
    except (OSError, subprocess.TimeoutExpired):
        pass
    return None


# ------------------------------------------------------------ terminal apps
# Emulator resolution for the windowed backend that replaces tmux when
# Terminator isn't on $PATH: $TERMINAL, then the system default
# (x-terminal-emulator), then a probe list of common emulators. Each knows
# how to open a titled window that runs one shell command.
_TERMINAL_PROBE_LIST = (
    "gnome-terminal", "konsole", "xfce4-terminal", "kitty", "alacritty",
    "wezterm", "xterm",
)


def _terminal_argv(binary_name, binary_path, title, cmd):
    if binary_name == "gnome-terminal":
        return [binary_path, "--title", title, "--", "bash", "-c", cmd]
    if binary_name == "konsole":
        return [binary_path, "-p", f"tabtitle={title}", "-e", "bash", "-c", cmd]
    if binary_name == "xfce4-terminal":
        return [binary_path, "--title", title, "--command", f"bash -c {shlex.quote(cmd)}"]
    if binary_name == "kitty":
        return [binary_path, "--title", title, "bash", "-c", cmd]
    if binary_name == "wezterm":
        return [binary_path, "start", "--", "bash", "-c", cmd]
    if binary_name in ("alacritty", "xterm"):
        title_flag = "-T" if binary_name == "xterm" else "--title"
        return [binary_path, title_flag, title, "-e", "bash", "-c", cmd]
    # Unrecognised emulator (e.g. an unknown x-terminal-emulator alternative):
    # the conventional `<term> -e <shell> -c <cmd>` form covers most of them.
    return [binary_path, "-e", "bash", "-c", cmd]


def resolve_terminal():
    # Returns (binary_name, binary_path) for the emulator run_windows() will
    # use, or None if nothing usable was found (caller falls through to
    # run_fallback()).
    env_term = os.environ.get("TERMINAL")
    if env_term:
        path = shutil.which(env_term)
        if path:
            return Path(env_term).name, path

    x_term = shutil.which("x-terminal-emulator")
    if x_term:
        # Resolve through the Debian alternatives symlink to a name
        # _terminal_argv() actually recognises.
        resolved = Path(os.path.realpath(x_term)).name
        return resolved, x_term

    for name in _TERMINAL_PROBE_LIST:
        path = shutil.which(name)
        if path:
            return name, path

    return None


