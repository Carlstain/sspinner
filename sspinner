    ("edit <name>", "edit a project's services (menu on a tty, $EDITOR otherwise)"),
    ("list", "show registered projects and live status"),
    ("status <name> [--json]", "show one project's status"),
    ("run <name> [-b]", "boot a registered project's stack (-b: background, no window)"),
    ("run <name> --only/--except a,b", "boot (or skip) just the named services"),
    ("restart <name> [svc...]", "tear down then boot, optionally scoped to some services"),
    ("stop <name>", "tear down a project's stack"),
    ("logs <name> [svc]", "tail one service's logs, or point at the Dozzle viewer"),
    ("exec <name> <svc> [-c C] <cmd>", "shortcut for 'docker compose exec' into a docker service"),
    ("doctor [name]", "read-only preflight: docker, paths, ports, runner binaries"),
