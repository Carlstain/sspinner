COMPOSE_FILENAMES = ("docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml")


def _detect_runner(path):
    p = Path(path)
    if any((p / f).exists() for f in COMPOSE_FILENAMES):
        return "docker-compose"
    if (p / "package.json").exists():
        if (p / "pnpm-lock.yaml").exists():
            return "pnpm"
        if (p / "yarn.lock").exists():
            return "yarn"
        return "npm"
    if (p / "pyproject.toml").exists():
        return "poetry"
    return None


def _package_json_scripts(path):
    pkg = Path(path) / "package.json"
    if not pkg.exists():
        return {}
    try:
        data = json.loads(pkg.read_text())
    except (json.JSONDecodeError, OSError):
        return {}
    scripts = data.get("scripts")
    return scripts if isinstance(scripts, dict) else {}


def _detect_port(path):
    p = Path(path)
    for fname in COMPOSE_FILENAMES:
        compose = p / fname
        if compose.exists():
            match = re.search(r'-\s*"?(\d{2,5}):\d{2,5}"?', compose.read_text())
            if match:
                return int(match.group(1))
            break
    pkg = p / "package.json"
    if pkg.exists():
        match = re.search(r'"PORT"\s*:\s*"?(\d{2,5})', pkg.read_text())
        if match:
            return int(match.group(1))
    return None


def configure_runner(runner, path):
    # Every question here is allow_back=True: this is where the "worst case"
    # trap lived (custom's required command prompt, no way out). If ANY
    # answer comes back BACK, propagate it immediately rather than partially
    # filling in the returned dict - register_one_service re-asks the runner
    # choice from scratch on BACK.
    if runner == "docker-compose":
        compose_project = ask("compose project name (-p)", required=True, allow_back=True)
        if compose_project is BACK:
            return BACK
        build = ask_yes_no("build image before starting?", default=True, allow_back=True)
        if build is BACK:
            return BACK
        return {"compose_project": compose_project, "build": build}
    if runner in ("yarn", "pnpm", "npm"):
        scripts = _package_json_scripts(path)
        if scripts:
            default_script = "dev" if "dev" in scripts else next(iter(scripts))
            options = [default_script] + [s for s in scripts if s != default_script]
            script = ask_choice(f"script to run ({runner} run <script>)", options, allow_back=True)
        else:
            script = ask("script to run", default="dev", allow_back=True)
        if script is BACK:
            return BACK
        return {"script": script}
    if runner == "poetry":
        command = ask("command to run after 'poetry run'", required=True, allow_back=True)
        if command is BACK:
            return BACK
        return {"command": command}
    if runner == "custom":
        command = ask("full shell command to run", required=True, allow_back=True)
        if command is BACK:
            return BACK
        return {"command": command}
    raise ValueError(runner)


def register_one_service(project_slug, existing_names):
    heading("New service")
    while True:
        name = ask("name (e.g. back, front, keycloak)", required=True)
        if name not in existing_names:
            break
        print(dim(f"    '{name}' is already used in this project, pick another"))
    path = ask_path("path (directory)")

    detected = _detect_runner(path)
    runner_options = RUNNERS
    if detected and detected in RUNNERS:
        runner_options = [detected] + [r for r in RUNNERS if r != detected]
        print(dim(f"    detected: {detected} (based on files in {path})"))

    # runner ask_choice does NOT get allow_back - there's nothing sensible to
    # back out to before it, so Esc there is simply ignored (stays put).
    # configure_runner's own follow-up questions do get allow_back; if the
    # user backs out of one of those, loop back and re-ask the runner choice
    # (detection/pre-fills behave the same on re-entry since runner_options
    # was already computed above).
    while True:
        runner = ask_choice("how is it run?", runner_options)
        extra = configure_runner(runner, path)
        if extra is not BACK:
            break

    default_port = _detect_port(path)
    if default_port:
        print(dim(f"    detected port: {default_port}"))
    port = ask_optional_int(
        "port to wait on before starting the next service (blank = none)",
        default=default_port,
    )
    svc = {"name": name, "path": path, "runner": runner, "port": port}
    svc.update(extra)
    if runner == "docker-compose" and not svc.get("compose_project"):
        svc["compose_project"] = f"{project_slug}-{name}"
    return svc


def print_service_summary(services):
    rows = []
    for i, svc in enumerate(services, 1):
        extra = svc.get("compose_project") or svc.get("script") or svc.get("command", "") or "-"
        port = f":{svc['port']}" if svc.get("port") else "-"
        rows.append([str(i), svc["name"], svc["runner"], port, extra])
    print(render_table(["#", "service", "runner", "port", "detail"], rows))


def _reorder_services(services):
    n = len(services)
    example = ",".join(str(i) for i in range(n, 0, -1))
    while True:
        raw = ask(f"new order, comma-separated 1-{n} (e.g. {example})", required=True)
        try:
            order = [int(x.strip()) for x in raw.split(",")]
        except ValueError:
            print(dim("    not a list of numbers, try again"))
            continue
        if sorted(order) != list(range(1, n + 1)):
            print(dim(f"    must be a permutation of 1-{n}, try again"))
            continue
        reordered = [services[i - 1] for i in order]
        heading("New order")
        print_service_summary(reordered)
        return reordered


def cmd_register(args):
    registry = load_registry()
    existing = registry.get(args.name)
    services = []
    network = None

    if existing:
        heading(f"'{args.name}' is already registered")
        print_service_summary(existing.get("services", []))
        choice = ask_choice(
            "what do you want to do?",
            ["Add more services to it", "Start over (replace everything)", "Cancel"],
        )
        if choice == "Cancel":
            return
        if choice == "Add more services to it":
            services = existing.get("services", [])
            network = existing.get("network")

    from_name = getattr(args, "from_project", None)
    if from_name and not services:
        source = registry.get(from_name)
        if source is None:
            err(f"'{from_name}' isn't registered - nothing to clone from.")
            sys.exit(1)
        heading(f"Cloning '{from_name}' -> '{args.name}'")
        network = source.get("network")
        for src_svc in source["services"]:
            svc = dict(src_svc)
            print(dim(f"  {svc['name']} ({svc['runner']}) - confirm its path and port"))
            svc["path"] = ask_path(f"path for '{svc['name']}'", default=svc.get("path"))
            svc["port"] = ask_optional_int(
                f"port for '{svc['name']}' (blank = none)", default=svc.get("port")
            )
            if svc["runner"] == "docker-compose":
                svc["compose_project"] = ask(
                    "compose project name (-p)",
                    default=f"{slugify(args.name)}-{svc['name']}", required=True,
                )
            services.append(svc)
        heading("Cloned services")
        print_service_summary(services)

    if network is None:
        network = ask(
            "shared docker network these services need (blank if none)", default=""
        ) or None

    existing_names = {s["name"] for s in services}
    while True:
        if not ask_yes_no("Add a service?", default=(len(services) == 0)):
            break
        svc = register_one_service(slugify(args.name), existing_names)
        services.append(svc)
        existing_names.add(svc["name"])
        heading("Services so far")
        print_service_summary(services)

    if not services:
        warn("no services added, nothing saved")
        return

    if len(services) > 1 and ask_yes_no("reorder services? (boot order matters)", default=False):
        services = _reorder_services(services)

    heading(f"Final config for '{args.name}'")
    print_service_summary(services)
    problems = _validate_entry({"network": network, "services": services})
    for p in problems:
        warn(p)
    if not ask_yes_no("Save this configuration?", default=True):
        warn("not saved")
        return

    registry[args.name] = {"network": network, "services": services}
    save_registry(registry)
    ok(f"saved '{args.name}' ({len(services)} service(s)) -> {REGISTRY_PATH}")


def _validate_entry(entry):
    # Returns a list of human-readable problems, empty if none. Mirrors the
    # fields configure_runner() itself requires per runner, so a hand-edited
    # (or badly cloned) entry is caught here instead of surfacing later as a
    # raw ValueError out of build_pane_command().
    problems = []
    services = entry.get("services")
    if not isinstance(services, list) or not services:
        return ["'services' must be a non-empty list"]

    seen_names = set()
    seen_ports = set()
    for i, svc in enumerate(services):
        name = svc.get("name")
        label = name or f"service #{i + 1}"
        if not name:
            problems.append(f"service #{i + 1}: missing 'name'")
        elif name in seen_names:
            problems.append(f"duplicate service name '{name}'")
        else:
            seen_names.add(name)

        runner = svc.get("runner")
        if runner not in RUNNERS:
            problems.append(f"{label}: unknown runner {runner!r} (must be one of {', '.join(RUNNERS)})")
        elif runner == "docker-compose" and not svc.get("compose_project"):
            problems.append(f"{label}: docker-compose services need 'compose_project'")
        elif runner in ("yarn", "pnpm", "npm") and not svc.get("script"):
            problems.append(f"{label}: '{runner}' services need a 'script'")
        elif runner in ("poetry", "custom") and not svc.get("command"):
            problems.append(f"{label}: '{runner}' services need a 'command'")

        path = svc.get("path")
        if not path or not str(path).startswith("/"):
            problems.append(f"{label}: 'path' must be an absolute path")

        port = svc.get("port")
        if port is not None:
            if not isinstance(port, int):
                problems.append(f"{label}: 'port' must be an integer or null")
            elif port in seen_ports:
                problems.append(f"{label}: port {port} is already used by another service in this project")
            else:
                seen_ports.add(port)
    return problems


def _edit_raw_entry(entry):
    # Opens `entry` as JSON in $EDITOR and returns the parsed, validated
    # result, or None if the user's edit was invalid/discarded - the caller
    # decides what "discarded" means (cmd_edit's non-tty path exits
    # non-zero; its interactive menu just drops back to the menu).
    editor = shlex.split(os.environ.get("EDITOR", "nano"))
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as tf:
        json.dump(entry, tf, indent=2)
        tf.write("\n")
        tmp_path = tf.name
    try:
        subprocess.run([*editor, tmp_path], check=True)
        try:
            new_entry = json.loads(Path(tmp_path).read_text())
        except json.JSONDecodeError as e:
            err(f"invalid JSON, discarded: {e}")
            return None
        problems = _validate_entry(new_entry)
        if problems:
            err("problems found, discarded:")
            for p in problems:
                err(f"  {p}")
            return None
        return new_entry
    finally:
        os.unlink(tmp_path)


def cmd_edit(args):
    registry = load_registry()
    entry = _require_project(registry, args.name)

    if not _interactive():
        # Same shape as before this command grew an interactive front door:
        # straight to $EDITOR on the raw JSON, now validated on the way back.
        edited = _edit_raw_entry(entry)
        if edited is None:
            sys.exit(1)
        registry[args.name] = edited
        save_registry(registry)
        ok(f"saved changes to '{args.name}'")
        return

    services = list(entry.get("services", []))
    network = entry.get("network")
    while True:
        heading(f"Editing '{args.name}'")
        print_service_summary(services)
        choice = ask_choice("what do you want to do?", [
            "Add a service",
            "Remove a service",
            "Reorder services",
            "Change shared network",
            "Open raw JSON in $EDITOR",
            "Save and exit",
            "Cancel (discard changes)",
        ])
        if choice == "Add a service":
            existing_names = {s["name"] for s in services}
            services.append(register_one_service(slugify(args.name), existing_names))
        elif choice == "Remove a service":
            if not services:
                warn("nothing to remove")
                continue
            target = ask_choice("remove which service?", [s["name"] for s in services])
            services = [s for s in services if s["name"] != target]
        elif choice == "Reorder services":
            if len(services) > 1:
                services = _reorder_services(services)
            else:
                warn("nothing to reorder")
        elif choice == "Change shared network":
            network = ask(
                "shared docker network these services need (blank if none)",
                default=network or "",
            ) or None
        elif choice == "Open raw JSON in $EDITOR":
            edited = _edit_raw_entry({"network": network, "services": services})
            if edited is not None:
                network = edited.get("network")
                services = edited.get("services", [])
        elif choice == "Save and exit":
            problems = _validate_entry({"network": network, "services": services})
            if problems:
                for p in problems:
                    warn(p)
                if not ask_yes_no("save anyway?", default=False):
                    continue
            registry[args.name] = {"network": network, "services": services}
            save_registry(registry)
            ok(f"saved changes to '{args.name}'")
            return
        else:  # Cancel
            warn("discarded")
            return


def _project_rows(name, entry):
    # Shared row builder for cmd_list and cmd_status - one project's
    # services rendered identically in both, rather than two copies of the
    # same status-cell/detail-column logic drifting apart.
    rows = []
    for svc in entry["services"]:
        status = _status_cell(svc, project=name)
        extra = svc.get("compose_project") or svc.get("script") or svc.get("command", "") or "-"
        if svc.get("port"):
            port = (f"localhost:{svc['port']}", Link(f"http://localhost:{svc['port']}"))
        else:
            port = "no port"
        rows.append([svc["name"], svc["runner"], port, extra, status])
    return rows


_LIST_COLUMNS = ["service", "runner", "port", "detail", "status"]
_LIST_TWO_COLUMN_MIN_WIDTH = 150
_LIST_COLUMN_GAP = 4


def _pad_visible(text, width):
    # Pad on the *plain* length, same discipline render_table()'s own
    # padding follows - text can carry ANSI color/OSC 8 codes from paint()/
    # hyperlink(), and those bytes must never count toward column width.
    return text + " " * max(0, width - _visible_len(text))


def _project_block_lines(name, entry, width):
    # One project's heading + table, both sized to `width` instead of the
    # live terminal width, as a list of already-painted lines - the unit
    # cmd_list()'s two-column layout zips two of side by side.
    lines = [_heading_line(name, width=width)]
    lines.extend(render_table(_LIST_COLUMNS, _project_rows(name, entry), max_width=width).split("\n"))
    return lines


def cmd_list(args):
    registry = load_registry()
    if not registry:
        heading("No projects registered yet")
        print("  sspinner boots per-project local dev stacks, each service in")
        print("  its own visible window, booted in order.")
        print(f"\n  {paint('sspinner register <name>', C.BOLD, C.BLUE)} to register your first one")
        return

    total_services = sum(len(e["services"]) for e in registry.values())
    running_count = sum(
        1 for name, e in registry.items() for svc in e["services"]
        if service_running(svc, project=name)
    )
    print(dim(
        f"  {len(registry)} project{'s' if len(registry) != 1 else ''} · "
        f"{running_count} running · "
        f"{total_services} service{'s' if total_services != 1 else ''}"
    ))
    projects = sorted(registry.items())
    term_width = shutil.get_terminal_size().columns
    half_width = (term_width - _LIST_COLUMN_GAP) // 2
    if len(projects) >= 2 and term_width >= _LIST_TWO_COLUMN_MIN_WIDTH:
        # Wide terminal, more than one project: lay them out two-up instead
        # of stacking every table vertically regardless of how much
        # horizontal room is sitting unused. Same render_table() output per
        # project (clamped to half_width instead of the full terminal) -
        # only the placement changes.
        for i in range(0, len(projects), 2):
            left_name, left_entry = projects[i]
            right = projects[i + 1] if i + 1 < len(projects) else None
            print()
            left_lines = _project_block_lines(left_name, left_entry, half_width)
            if right is None:
                for line in left_lines:
                    print(line)
                continue
            right_name, right_entry = right
            right_lines = _project_block_lines(right_name, right_entry, half_width)
            for j in range(max(len(left_lines), len(right_lines))):
                left = left_lines[j] if j < len(left_lines) else ""
                right_side = right_lines[j] if j < len(right_lines) else ""
                print(_pad_visible(left, half_width) + " " * _LIST_COLUMN_GAP + right_side)
    else:
        for name, entry in projects:
            heading(name)
            print(render_table(_LIST_COLUMNS, _project_rows(name, entry)))
    print(dim("\n  logs: ") + hyperlink(dim(DOZZLE_URL), DOZZLE_URL))


def _require_project(registry, name):
    # Shared "does this project exist" gate for run/stop/edit/status/
    # restart/logs/exec - suggests the nearest registered name on a typo
    # instead of just failing, via difflib against the registry's own keys.
    entry = registry.get(name)
    if entry is not None:
        return entry
    suggestion = difflib.get_close_matches(name, registry.keys(), n=1)
    if suggestion:
        err(f"'{name}' isn't registered - did you mean '{suggestion[0]}'?")
    else:
        err(f"'{name}' isn't registered. Run 'sspinner list' to see what is.")
    sys.exit(1)


